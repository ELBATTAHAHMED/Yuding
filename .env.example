# ====================================================================
# Yuding V2 - Environment Variables Template
#
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or credentials into version control!
# ====================================================================

# --------------------------------------------------------------------
# 0. Environment & Profiles
# --------------------------------------------------------------------
# Active Spring Profile: dev | test | staging | prod
SPRING_PROFILES_ACTIVE=dev

# Config Server Profile & Search Locations (native file-system config)
CONFIG_SERVER_PROFILE=native
CONFIG_SEARCH_LOCATIONS=classpath:/config,file:./config,file:../config,file:../../config,file:/config

# --------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 + pgvector)
# IMPORTANT:
# - Local host machine development: DB_PORT=5433 (JudgeLab uses 5432!)
# - Docker container network (compose): DB_PORT=5432, DB_HOST=postgres
# - Staging / Production: use managed cloud DB or container network
# --------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yuding
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Optional full JDBC URL override (e.g. cloud managed PostgreSQL)
# DB_URL=jdbc:postgresql://localhost:5433/yuding

# --------------------------------------------------------------------
# 2. Redis Configuration (Cache, Rate Limiting & Session)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------------
# 3. Core Infrastructure Services
# --------------------------------------------------------------------
DISCOVERY_SERVICE_URL=http://localhost:8761/eureka
CONFIG_SERVICE_URL=http://localhost:9091
GATEWAY_SERVICE_URL=http://localhost:8888

# --------------------------------------------------------------------
# 4. Frontend Web (Next.js)
# --------------------------------------------------------------------
# Target API Gateway URL (default: http://localhost:8888)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8888
# Environment identifier: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# --------------------------------------------------------------------
# 5. Security & Authentication (JWT - RS256 / HS256)
# Minimum 256-bit (32+ chars) cryptographically secure secret
# In staging/prod, MUST be supplied via secure secret manager or environment.
# --------------------------------------------------------------------
JWT_SECRET=yuding_v2_development_super_secret_jwt_key_replace_in_production_min_32_chars!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Wildcards (*) forbidden in prod.
# --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:63342,http://127.0.0.1:5500

# --------------------------------------------------------------------
# 7. AI Service (OpenAI & Embeddings)
# --------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------
# 8. Payment Provider (PaymentProvider Abstraction)
# --------------------------------------------------------------------
PAYMENT_PROVIDER=MOCK
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# --------------------------------------------------------------------
# 9. Notification & Mail Service
# --------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@yuding.travel
