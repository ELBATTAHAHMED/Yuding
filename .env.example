# ====================================================================
# Yuding V2 - Environment Variables Template
#
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or credentials into version control!
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 + pgvector)
# --------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=yuding
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --------------------------------------------------------------------
# 2. Redis Configuration (Cache, Rate Limiting & Session)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------------
# 3. Core Infrastructure Services
# --------------------------------------------------------------------
DISCOVERY_SERVICE_URL=http://localhost:8761/eureka
CONFIG_SERVICE_URL=http://localhost:9091
GATEWAY_SERVICE_URL=http://localhost:8888

# --------------------------------------------------------------------
# 4. Security & Authentication (JWT - Target Phase 10)
# Minimum 256-bit (32+ chars) cryptographically secure secret for HMAC-SHA256
# --------------------------------------------------------------------
JWT_SECRET=yuding_v2_development_super_secret_jwt_key_replace_in_production_min_32_chars!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Wildcards (*) are forbidden in prod.
# --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:63342,http://127.0.0.1:5500

# --------------------------------------------------------------------
# 6. AI Service (OpenAI & Embeddings)
# --------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------
# 7. Payment Provider (PaymentProvider Abstraction)
# --------------------------------------------------------------------
PAYMENT_PROVIDER=MOCK
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# --------------------------------------------------------------------
# 8. Notification & Mail Service
# --------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@yuding.travel
