# ====================================================================
# Yuding V2 - Frontend Web Environment Template (.env.example)
#
# Copy to '.env.local' for local developer overrides.
#
# SECURITY WARNING:
# Any variable starting with NEXT_PUBLIC_ is bundled into client-side
# JavaScript and exposed to the browser.
# NEVER place secrets, database passwords, or private keys here!
# ====================================================================

# Gateway Service URL (default local: http://localhost:8888)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8888

# Application Environment: development | staging | production | test
NEXT_PUBLIC_APP_ENV=development
