# ==============================================================================
# Yuding V2 - Travel Service Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your personal development credentials.
# .env.local is Git-ignored and must NEVER be committed.
#
# RULE: Yuding is a personal/portfolio project. Only Evaluation/Sandbox
# credentials must be used. Never use production or live transactional keys.
# ==============================================================================

# Flights Provider (Scrappa) - Working (Phase 22)
SCRAPPA_API_KEY=
SCRAPPA_BASE_URL=https://scrappa.co/api
TRAVEL_FLIGHTS_PROVIDER=scrappa

# Hotels Provider (Nuitee Connect / LiteAPI v3) - Working (Phase 23)
NUITEE_API_KEY=
NUITEE_BASE_URL=https://api.liteapi.travel/v3.0
TRAVEL_HOTELS_PROVIDER=nuitee

# Activities Provider (HBX Group / Hotelbeds APITUDE) - Resumed / Pending Implementation (Phase 24)
HBX_ACTIVITIES_API_KEY=
HBX_ACTIVITIES_SECRET=
HBX_ACTIVITIES_BASE_URL=https://api.test.hotelbeds.com/activity-api/3.0
TRAVEL_ACTIVITIES_PROVIDER=hbx

# Transfers Provider (HBX Group / Hotelbeds APITUDE) - Pending Implementation (Phase 25)
HBX_TRANSFERS_API_KEY=
HBX_TRANSFERS_SECRET=
HBX_TRANSFERS_BASE_URL=https://api.test.hotelbeds.com/transfer-api/1.0
TRAVEL_TRANSFERS_PROVIDER=hbx

# Trains Provider: Local ONCF GTFS Dataset (Active for Current & Future Schedules)
TRAVEL_TRAINS_PROVIDER=oncf_gtfs
ONCF_GTFS_DATA_PATH=data/oncf-gtfs
ONCF_GTFS_ENABLED=true

# Trains Provider (Transitland / ONCF GTFS) - Secondary / Fallback
TRANSITLAND_API_KEY=
TRANSITLAND_BASE_URL=https://transit.land/api/v2/rest
TRANSITLAND_ONCF_OPERATOR_ID=o-oncf~morocco
TRANSITLAND_ONCF_FEED_ID=f-oncf~morocco~rail

# Global Trains Provider: Transitous (MOTIS v2 Public API - No API key required)
TRANSITOUS_BASE_URL=https://api.transitous.org/api
TRANSITOUS_USER_AGENT=Yuding/2.0 (contact-url-or-email)
TRAVEL_GLOBAL_TRAINS_PROVIDER=transitous

# Geo & Places Provider (Geoapify) - Phase 26
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_MAPS_BASE_URL=https://maps.geoapify.com
TRAVEL_GEO_PROVIDER=geoapify
GEOAPIFY_DEFAULT_LANGUAGE=en
GEOAPIFY_AUTOCOMPLETE_LIMIT=8
GEOAPIFY_PLACES_LIMIT=20

# Live Weather Provider (Open-Meteo) - Phase 27. No API key is required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
TRAVEL_WEATHER_PROVIDER=open-meteo
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_TIMEZONE=auto

# Currency Provider (Frankfurter v2) - Phase 28. No API key is required.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
TRAVEL_CURRENCY_PROVIDER=frankfurter
TRAVEL_DISPLAY_CURRENCY=MAD
