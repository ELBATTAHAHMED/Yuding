# =============================================================================
# travel-service — ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is Git-ignored; this file is safe to commit.
#
# Load .env.local into the process before starting travel-service:
#   scripts/start-travel-service.ps1
# =============================================================================

# Scrappa flight search provider
SCRAPPA_API_KEY=your-scrappa-api-key-here
SCRAPPA_BASE_URL=https://scrappa.co/api
TRAVEL_FLIGHTS_PROVIDER=scrappa

# Nuitee hotel search provider (LiteAPI v3 Sandbox)
NUITEE_API_KEY=
NUITEE_BASE_URL=https://api.liteapi.travel/v3.0
TRAVEL_HOTELS_PROVIDER=nuitee
